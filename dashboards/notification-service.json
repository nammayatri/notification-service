{
  "uid": "ns-benchmark",
  "title": "Notification Service",
  "tags": ["notification-service", "benchmark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "cell",
        "label": "Cell",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(connected_clients, cell)", "refId": "A" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Decision",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "gRPC share (first push ≤ 1s)",
      "description": "Share of FIRST pushes landing inside the ~1s FCM fallback deadline. The driver app takes the FCM copy when the gRPC push is late, so this IS gRPC adoption. Target ≥ 90%. attempt=\"first\" is load-bearing: NACK is recorded on every push and the sweep resends until acked, so without the filter a 500ms sweep is marked down for resending after the deadline while pubsub scores 100% for never resending — the ranking would be an artefact of the interval, not a measurement of adoption.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", attempt=\"first\", le=~\"1(\\\\.0)?\", cell=~\"$cell\"}[$__rate_interval])) / sum by (cell) (rate(notification_duration_seconds_count{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "{{cell}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Redis reads / notification",
      "description": "Real Redis work per notification delivered, the honest cost number. Sweep reads every connected client's stream every cycle whether or not it has anything, so its cost is clients x sweep_hz and is independent of the notification rate; Pubsub reads once per notification. redis_commands_total cannot show this because backfill_new_entries batches one multi-key XREAD per shard, counting one command however many streams it reads. Lower is better. Sweep only wins below roughly 13.6 x the notification rate in connected clients.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(connected_clients{cell=~\"$cell\"}) * avg(rate(measure_duration_seconds_count{function=\"full_sweep\", cell=~\"$cell\"}[$__rate_interval])) + sum(rate(redis_commands_total{cmd=~\"xadd|xdel|expire|multi|exec|publish\"}[$__rate_interval])) + sum(rate(redis_cluster_stats_messages_publish_sent[$__rate_interval]))) / clamp_min(sum(rate(total_notifications{cell=~\"$cell\"}[$__rate_interval])), 0.001)",
          "legendFormat": "reads/notification"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Load shape vs crossover",
      "description": "Connected clients divided by the crossover point (13.6 x notification rate). BELOW 1.0 this run is in territory where polling is cheaper; ABOVE 1.0 push is cheaper, and the further above, the more lopsided. This is the single number that decides Sweep vs Pubsub, and it is a property of the LOAD, not of the code. Prod sits around 72 (771k clients at 786 notif/s). A bench that sits below 1.0 cannot rank the modes on cost no matter how long it runs — raise the client count until this exceeds prod's value.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(connected_clients{cell=~\"$cell\"}) / clamp_min(13.6 * sum(rate(total_notifications{cell=~\"$cell\"}[$__rate_interval])), 0.001)",
          "legendFormat": "clients / crossover"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Connected clients",
      "description": "Service gauge vs what the fleet believes it is holding. A persistent gap means streams the service dropped without the client noticing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(connected_clients{cell=~\"$cell\"})", "legendFormat": "service" },
        { "refId": "B", "expr": "sum(sim_connected_clients)", "legendFormat": "fleet" }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "gRPC share over time",
      "description": "The point of 5s scraping: a mid-run collapse shows as a cliff here instead of being averaged into a single number.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", attempt=\"first\", le=~\"1(\\\\.0)?\", cell=~\"$cell\"}[$__rate_interval])) / sum by (cell) (rate(notification_duration_seconds_count{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "{{cell}}"
        },
        { "refId": "B", "expr": "90", "legendFormat": "target 90%" }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Redis work: poll vs push",
      "description": "The cost comparison, in real Redis reads per second. 'sweep polling (measured)' is connected clients x achieved sweep rate — what this mode actually costs, and it is flat in the notification rate. 'pubsub push (modelled)' is what the same load would cost as pushes: one read per notification plus the cluster-bus broadcast to every other node. In a Sweep run the modelled line is the counterfactual, and vice versa. Whichever line is lower wins on cost at THIS client count; the ranking flips with load, so read it together with 'Load shape vs crossover'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(connected_clients{cell=~\"$cell\"}) * avg(rate(measure_duration_seconds_count{function=\"full_sweep\", cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "sweep polling (measured)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(total_notifications{cell=~\"$cell\"}[$__rate_interval])) * (1 + max(redis_cluster_known_nodes))",
          "legendFormat": "pubsub push (modelled: 1 read + bus fanout)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(redis_commands_total{cmd=~\"xadd|xdel|expire|multi|exec\"}[$__rate_interval]))",
          "legendFormat": "producer writes (same in both modes)"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Push latency (first push)",
      "description": "First push of each notification only. Both ends come off one clock (the stream entry id's millisecond prefix), so there is no skew. This is the latency number to trust and what the KPI is read from. The dashed 'all pushes' series includes sweep re-pushes and is what prod Grafana shows, kept only for comparison against prod's 668ms.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p50 {{cell}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p90 {{cell}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p99 {{cell}}"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.50, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"NACK\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p50 all pushes {{cell}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Ack latency (device round trip)",
      "description": "The device round trip. A DIFFERENT span from the panel on the left; do not add them or compare them as one number. Only recorded when an ACK matches a pending entry, so it is empty under delivery_guarantee = AtMostOnce.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"ACK\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p50 {{cell}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"ACK\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p90 {{cell}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, cell) (rate(notification_duration_seconds_bucket{ack=\"ACK\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p99 {{cell}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Client delivery latency",
      "description": "produced_at_ms in the payload → receipt at the client, recorded on first sight of an id only. Crosses a pod boundary, so it carries clock skew the service's own histogram does not; treat a disagreement with push latency as a question, not a fact.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sim_delivery_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(sim_delivery_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(sim_delivery_latency_seconds_bucket{le=~\"1(\\\\.0)?\"}[$__rate_interval])) / sum(rate(sim_delivery_latency_seconds_count[$__rate_interval]))",
          "legendFormat": "share ≤1s (%)",
          "hide": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Push amplification",
      "description": "How many times the average notification is pushed before it is acked. Above 1 is the ledger re-pushing; this is what pins the sweep cycle and drives Redis cost. Read the first series: its denominator is first pushes, so unlike total_notifications it does not drift with reconnects.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (rate(notification_duration_seconds_count{ack=\"NACK\", cell=~\"$cell\"}[$__rate_interval])) / sum by (cell) (rate(notification_duration_seconds_count{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "pushes per pushed notification {{cell}}"
        },
        {
          "refId": "B",
          "expr": "sum by (cell) (rate(notification_duration_seconds_count{ack=\"NACK\", cell=~\"$cell\"}[$__rate_interval])) / sum by (cell) (rate(total_notifications{cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "vs total_notifications {{cell}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Sweep cycle (achieved)",
      "description": "full_sweep is backfill_new_entries + retry_pending_in_memory back to back; the loop then sleeps sweep_delay_millis, so the real cycle is this plus the configured delay. Delivery latency degrades silently rather than erroring (DESIGN.md §15), so a p90 approaching the interval means the cell did not run at the interval its name claims. Prod's 668ms NACK p50 implies a ~1.3s cycle against a 500ms budget.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, cell) (rate(measure_duration_seconds_bucket{function=\"full_sweep\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "full_sweep p50 {{cell}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le, cell) (rate(measure_duration_seconds_bucket{function=\"full_sweep\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "full_sweep p90 {{cell}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.90, sum by (le, cell) (rate(measure_duration_seconds_bucket{function=\"backfill_new_entries\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "backfill p90 {{cell}}"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.90, sum by (le, cell) (rate(measure_duration_seconds_bucket{function=\"read_client_notifications\", cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "xread p90 {{cell}}"
        },
        {
          "refId": "E",
          "expr": "sum by (cell) (rate(measure_duration_seconds_count{function=\"full_sweep\", cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "sweeps/sec {{cell}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Delivery outcomes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Notification flow (per second)",
      "description": "Producer writes → service sees → service pushes → client acks. A divergence between any two adjacent lines localises the loss.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "producer wrote" },
        { "refId": "B", "expr": "sum(rate(total_notifications{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "service read" },
        { "refId": "C", "expr": "sum(rate(notification_duration_seconds_count{ack=\"NACK\", attempt=\"first\", cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "service pushed (first)" },
        { "refId": "F", "expr": "sum(rate(notification_duration_seconds_count{ack=\"NACK\", cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "service pushed (incl. re-pushes)" },
        { "refId": "D", "expr": "sum(rate(sim_notifications_received_total[$__rate_interval]))", "legendFormat": "client received" },
        { "refId": "E", "expr": "(sum(rate(delivered_notifications{category!=\"UNKNOWN\", cell=~\"$cell\"}[$__rate_interval])) or vector(0)) + (sum(rate(unmatched_acks_total{cell=~\"$cell\"}[$__rate_interval])) or vector(0))", "legendFormat": "acked" }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Losses",
      "description": "reason=\"timeout\" expired after being pushed (device side); reason=\"no_consumer\" expired without ever being pushed (server side). cleanup_push_skipped is a leak rate, not a retry. retried counts notifications that needed at least one re-push, so it is comparable between Sweep and Pubsub; for the number of re-pushes read push amplification instead. Expect ~2% of notifications to expire on timeout from reconnect churn alone, on top of never_ack_pct.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(expired_notifications{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "expired {{reason}}" },
        { "refId": "B", "expr": "sum(rate(retried_notifications{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "retried" },
        { "refId": "C", "expr": "sum(rate(cleanup_push_skipped{cell=~\"$cell\"}[$__rate_interval])) or vector(0)", "legendFormat": "cleanup skipped" },
        { "refId": "D", "expr": "(sum(rate(unmatched_acks_total{cell=~\"$cell\"}[$__rate_interval])) or vector(0)) + (sum(rate(delivered_notifications{category=\"UNKNOWN\", cell=~\"$cell\"}[$__rate_interval])) or vector(0))", "legendFormat": "unmatched acks" }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Fleet health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Connected clients",
      "description": "'service' is what the pods report, 'fleet' is what sim-clients believe they hold. A persistent gap means streams the service has dropped but the client has not noticed, or vice versa.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(connected_clients{cell=~\"$cell\"})", "legendFormat": "service" },
        { "refId": "B", "expr": "sum(sim_connected_clients)", "legendFormat": "fleet" },
        { "refId": "C", "expr": "sum by (pod) (sim_connected_clients)", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Reconnects by reason (per second)",
      "description": "client_closed is the reconnect distribution cycling a stream and should dominate. server_closed is the request_timeout_seconds cycle. stream_error is not expected.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(sim_reconnects_total[$__rate_interval]))", "legendFormat": "{{reason}}" },
        { "refId": "B", "expr": "sum(rate(sim_connect_failures_total[$__rate_interval])) or vector(0)", "legendFormat": "connect failures" }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Duplicate deliveries (per second)",
      "description": "before_ack is the ledger re-pushing until acked — expected. after_ack is redelivery following an ack; at-least-once makes non-zero normal, a rising rate is not.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (phase) (rate(sim_duplicate_deliveries_total[$__rate_interval]))", "legendFormat": "{{phase}}" }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "Producer",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Write rate vs configured target",
      "description": "If actual sits below target the producer is the bottleneck and the cell is not measuring the service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 59 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "actual" },
        { "refId": "B", "expr": "max(sim_producer_target_rate{cell=~\"$cell\"})", "legendFormat": "target" },
        { "refId": "C", "expr": "sum by (locality) (rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))", "legendFormat": "{{locality}}" },
        { "refId": "D", "expr": "sum(rate(sim_producer_publishes_total{cell=~\"$cell\"}[$__rate_interval])) or vector(0)", "legendFormat": "published" }
      ]
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Producer write latency",
      "description": "The MULTI/XADD/EXPIRE/EXEC transaction the producer issues per notification. If this climbs, Redis is the bottleneck and every latency number downstream is contaminated.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 59 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(sim_producer_write_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.90, sum by (le) (rate(sim_producer_write_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))", "legendFormat": "p90" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(sim_producer_write_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Producer errors by op",
      "description": "Any non-zero rate invalidates the cell: notifications the service was never given cannot be counted against it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 59 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (op) (rate(sim_producer_errors_total{cell=~\"$cell\"}[$__rate_interval])) or vector(0)", "legendFormat": "{{op}}" }
      ]
    },
    {
      "type": "row",
      "id": 105,
      "title": "Redis / Valkey cost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 67 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Commands per second by type",
      "description": "The Sweep-vs-Pubsub comparison in one panel. Sweep spends it on xread; Pubsub trades that for publish plus a smaller xread.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cmd) (rate(redis_commands_total{cmd=~\"xread|xadd|xdel|expire|publish|multi|exec|xrange|del\"}[$__rate_interval]))",
          "legendFormat": "{{cmd}}"
        },
        { "refId": "B", "expr": "sum(rate(redis_commands_total[$__rate_interval]))", "legendFormat": "all commands", "hide": true }
      ]
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Redis CPU/s by command",
      "description": "Seconds of Valkey CPU burned per wall-clock second. Above ~1.0 per shard the instance is the bottleneck and latency numbers stop being about the service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 68 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cmd) (rate(redis_commands_duration_seconds_total{cmd=~\"xread|xadd|xdel|expire|publish|multi|exec|xrange|del\"}[$__rate_interval]))",
          "legendFormat": "{{cmd}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Bandwidth",
      "description": "XREAD request size scales with clients per shard, so in-bytes is where a wide fleet on a short sweep shows up first.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 76 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(redis_net_input_bytes_total[$__rate_interval]))", "legendFormat": "in" },
        { "refId": "B", "expr": "sum(rate(redis_net_output_bytes_total[$__rate_interval]))", "legendFormat": "out" }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Bytes per delivered notification",
      "description": "Bandwidth normalised by useful work — the figure that survives a change in fleet size.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 76 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(redis_net_input_bytes_total[$__rate_interval])) + sum(rate(redis_net_output_bytes_total[$__rate_interval]))) / clamp_min((sum(rate(delivered_notifications{category!=\"UNKNOWN\", cell=~\"$cell\"}[$__rate_interval])) or vector(0)) + (sum(rate(unmatched_acks_total{cell=~\"$cell\"}[$__rate_interval])) or vector(0)), 0.001)",
          "legendFormat": "bytes/delivery"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Memory and keys",
      "description": "The streams ARE the delivery ledger, so a rising memory floor means unacked entries accumulating. maxmemory-policy must be noeviction or this graph is measuring Valkey dropping the experiment.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 76 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "keys" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(redis_memory_used_bytes)", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(redis_db_keys)", "legendFormat": "keys" }
      ]
    },
    {
      "type": "timeseries",
      "id": 25,
      "title": "Exporter coverage",
      "description": "Prometheus scrapes redis_exporter once per master through /scrape?target=. XADD is issued exactly once per producer write, so this ratio is 1.0 when the node list covers every master and drops to masters_scraped/masters_total when it does not. Below 1.0 means the list is stale — most likely a Valkey recreate handed out new IPs, or the shard count changed. Re-derive BENCH_REDIS_NODES from CLUSTER NODES (k8s) or bump redisMasterCount in nix/services.nix (local) and re-apply. Every panel in this row is wrong by exactly this factor until it reads 1.0.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 84 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_commands_total{cmd=\"xadd\"}[$__rate_interval])) / sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "redis xadd / producer writes"
        },
        {
          "refId": "B",
          "expr": "1",
          "legendFormat": "expected 1.0"
        }
      ]
    },
    {
      "type": "row",
      "id": 106,
      "title": "Scaling model",
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 92 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 107,
      "title": "Msgs / notification (incl. bus)",
      "description": "The honest Redis cost. redis_commands_total counts a PUBLISH once, but Redis Cluster broadcasts it to every other node over the cluster bus, so the real cost carries an extra (nodes - 1) messages that no command counter shows. Sweep has no bus term. Compare modes on this line, never on the command count alone, and compare at equal grpc_share_pct.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 93 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(redis_commands_total{cmd=~\"xadd|xread|xdel|expire|multi|exec|publish\"}[$__rate_interval])) + sum(rate(redis_cluster_stats_messages_publish_sent[$__rate_interval]))) / sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "total msgs / notification"
        },
        {
          "refId": "B",
          "expr": "sum(rate(redis_commands_total{cmd=~\"xadd|xread|xdel|expire|multi|exec|publish\"}[$__rate_interval])) / sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "app commands only"
        },
        {
          "refId": "C",
          "expr": "sum(rate(redis_cluster_stats_messages_publish_sent[$__rate_interval])) / sum(rate(sim_producer_notifications_total{cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "cluster bus only"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 108,
      "title": "Fanout: measured vs predicted",
      "description": "Both multipliers are linear and infrastructure-bound, so a small run measures them accurately and scripts/bench-model.py projects them. Cluster-bus fanout must equal redis_cluster_known_nodes - 1. Subscriber fanout must equal the pod count, because pubsub_channel_key() is one global channel and every pod receives every notification. If a measured line drifts from its predicted pair, the projection is invalid — find out why before trusting any prod estimate.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 101 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_cluster_stats_messages_publish_sent[$__rate_interval])) / clamp_min(sum(rate(redis_commands_total{cmd=\"publish\"}[$__rate_interval])), 0.001)",
          "legendFormat": "bus fanout (measured)"
        },
        {
          "refId": "B",
          "expr": "max(redis_cluster_known_nodes) - 1",
          "legendFormat": "bus fanout (predicted = nodes - 1)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pubsub_messages_total[$__rate_interval])) / clamp_min(sum(rate(pubsub_messages_total{outcome=\"local\"}[$__rate_interval])), 0.001)",
          "legendFormat": "subscriber fanout (measured)"
        },
        {
          "refId": "D",
          "expr": "count(up{job=\"notification-service\"})",
          "legendFormat": "subscriber fanout (predicted = pods)"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 109,
      "title": "Pub/Sub foreign wakeups",
      "description": "outcome=\"foreign\" is a pod waking for a notification belonging to another pod's client, because pubsub_channel_key() is one global channel. It costs Redis->pod network delivery plus a map lookup and NOTHING on Redis: active_notification() returns at the lookup without issuing a command, so foreign messages are absent from redis_commands_total by construction. Each pod handles the full notification rate whatever its share, so this is (pods - 1)/pods of all wakeups but only a few thousand cheap lookups per second even at prod scale. Read it as a design smell and a network figure, not as Redis load. no_session is a client this pod knows but holds no live stream for.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 101 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(pubsub_messages_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 110,
      "title": "Real loss (expired − never-ack)",
      "description": "sim.dhall sets never_ack_pct, a cohort designed never to ack, so those notifications are supposed to expire. Raw expired_notifications therefore reads ~never_ack_pct even on a perfectly healthy run and is not a loss metric. This panel subtracts the designed baseline; anything above zero is genuine delivery loss.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 109 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(expired_notifications[$__rate_interval])) - sum(rate(sim_notifications_never_acked_total[$__rate_interval]))",
          "legendFormat": "expired above baseline (real loss)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(expired_notifications[$__rate_interval]))",
          "legendFormat": "expired (raw — includes the designed never-ack cohort)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(notification_duration_seconds_bucket{ack=\"NACK\",attempt=\"repeat\",le=\"+Inf\"}[$__rate_interval]))",
          "legendFormat": "actual repeat pushes (retried_notifications undercounts these ~2.3x)"
        }
      ]
    }
  ]
}
